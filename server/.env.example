# OjaX server configuration — copy to .env and adjust.

# --- core ---
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CLIENT_ORIGIN=*

# --- database ---
DATABASE_URL=postgres://ojax:ojax_dev_pass@127.0.0.1:5432/ojax

# --- auth ---
# CHANGE THIS in any real deployment. `openssl rand -hex 32` to generate.
JWT_SECRET=replace-me-with-a-long-random-string
ACCESS_TOKEN_TTL_SEC=43200
REFRESH_TOKEN_TTL_DAYS=30

# --- uploads ---
# UPLOAD_ROOT=/absolute/path/to/uploads
MAX_UPLOAD_BYTES=10485760
MAX_FILES_PER_REQUEST=8
MAX_LISTING_PHOTOS=8

# --- business rules (money stored in kobo: 100 kobo = N1) ---
SHIPPING_FEE_KOBO=250000
FREE_SHIPPING_ABOVE_KOBO=2000000
SERVICE_FEE_RATE_PERCENT=0
CHECKOUT_HOLD_MINUTES=90

# --- payments ---
# Demo runs on the built-in sandbox gateway. To go live, set PAYMENT_GATEWAY=paystack
# and provide your Paystack keys (server signs + verifies, client shows checkout.js).
PAYMENT_GATEWAY=sandbox
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- email (dev logs to console instead of sending) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OjaX <hello@ojax.app>

# --- misc ---
PUBLIC_BASE_URL=http://localhost:4000
DEMO_SEED=true
